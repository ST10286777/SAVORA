<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_black">


    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:clipToPadding="false"
        android:layout_marginBottom="56dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="150dp"
            android:layout_height="100dp"
            android:src="@drawable/logo_savora"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Amount Input -->
        <EditText
            android:id="@+id/etAmount"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="Amount"
            android:inputType="numberDecimal"
            android:backgroundTint="@color/primary_orange"
            android:textColorHint="@color/primary_orange"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/imageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Category Spinner -->
        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:backgroundTint="@color/primary_orange"
            android:textColor="@color/primary_orange"
            android:textColorHint="@color/primary_orange"
            android:popupBackground="@color/background_black"
            app:layout_constraintTop_toBottomOf="@id/etAmount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Description Input -->
        <EditText
            android:id="@+id/etDescription"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:hint="Description"
            android:gravity="top"
            android:backgroundTint="@color/primary_orange"
            android:textColorHint="@color/primary_orange"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/spinnerCategory"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Date Selection -->
        <Button
            android:id="@+id/btnSelectDate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Select Date"
            android:backgroundTint="@color/primary_orange"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/etDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvDate"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Today"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/etDescription"
            app:layout_constraintStart_toEndOf="@id/btnSelectDate"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp" />

        <!-- Time Selection -->
        <Button
            android:id="@+id/btnSelectStartTime"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Start Time"
            android:backgroundTint="@color/primary_orange"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/btnSelectDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvStartTime"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvStartTime"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/btnSelectDate"
            app:layout_constraintStart_toEndOf="@id/btnSelectStartTime"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btnSelectEndTime"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="End Time"
            android:backgroundTint="@color/primary_orange"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/btnSelectStartTime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvEndTime"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvEndTime"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="01:00"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/btnSelectStartTime"
            app:layout_constraintStart_toEndOf="@id/btnSelectEndTime"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp" />

        <!-- Photo Buttons -->
        <Button
            android:id="@+id/btnAttachReceipt"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Attach Receipt"
            android:backgroundTint="@color/primary_orange"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/btnSelectEndTime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCapturePhoto"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnCapturePhoto"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Take Photo"
            android:backgroundTint="@color/primary_orange"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/btnSelectEndTime"
            app:layout_constraintStart_toEndOf="@id/btnAttachReceipt"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveExpense"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Save Transaction"
            android:backgroundTint="@color/primary_orange"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/btnAttachReceipt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Bottom Navigation View -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="@color/primary_orange"
        app:itemIconTint="@android:color/white"
        app:itemTextColor="@android:color/white"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>